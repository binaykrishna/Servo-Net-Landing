        },
        {
          "category": "ASPIRATIONAL",
          "qualification_criteria": "Premium grade sales > 5% of total primary sales OR 30 KL (whichever lower) during previous quarter (July-Sept 2026)",
          "benefit_rate_inr_per_litre": 1
