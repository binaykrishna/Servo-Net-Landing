        {
          "criteria_premium_share": "> 12%",
          "min_share_pct": 12.01,
          "max_share_pct": 100,
          "volume_cap": "40 KL or actual volume (whichever lower)",
          "volume_cap_kl": 40,
          "mass_trade_discount_pct": 5
        },
        {
          "criteria_premium_share": "> 10% to <= 12%",
          "min_share_pct": 10.01,
          "max_share_pct": 12,
          "volume_cap": "35 KL or actual volume (whichever lower)",
          "volume_cap_kl": 35,
          "mass_trade_discount_pct": 4.5
