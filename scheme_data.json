      "target_group": "Stockists",
      "period": "Oct - Dec 2026",
      "reference_evaluation_period": "Previous Quarter (July - Sept 2026)",
      "settlement": "Evaluated quarterly via SAP; payable on primary sales of Aspirational & Premium grades uplifted during Oct-Dec 2026",
      "categories": [
        {
          "category": "PREMIUM",
          "qualification_criteria": "Premium grade sales > 10% of total primary sales OR 60 KL (whichever lower) during previous quarter (July-Sept 2026)",
